{
  "name": "gdscript-import",
  "displayName": "GDScript Import",
  "description": "Auto-imports GDScript classes via preload",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:gdscript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gdscript",
        "extensions": [
          ".gd"
        ]
      }
    ]
  },
  "repository": "https://github.com/lilrosemary/gdscript-import",
  "scripts": {
    "package": "vsce package",
    "vscode:prepublish": "npm run build:prod",
    "build": "npm run check-types && npm run lint && node esbuild.js",
    "build:prod": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
